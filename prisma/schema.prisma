// Shiksha Sarthi — Virtual Learning Platform
// Data model for the student-facing site/PWA and the admin panel.
//
// Enum-like columns are plain Strings (SQLite has no native enums) and the
// allowed values live in src/lib/constants.ts so both layers stay in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  dob          String?
  gender       String?
  avatarUrl    String?
  role         String  @default("STUDENT") // STUDENT | ADMIN | PARTNER
  city         String?
  state        String?

  /// Set only for PARTNER users — the institution whose catalogue they manage.
  /// A PARTNER whose universityId is null is a pending sign-up: they can log in
  /// but can't publish anything until an operator approves the partnership.
  universityId String?
  university   University? @relation("PartnerStaff", fields: [universityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments      Enrollment[]
  applications     Application[]
  certificates     Certificate[]
  testAttempts     TestAttempt[]
  lessonProgress   LessonProgress[]
  reviews          Review[]
  uploadedMaterial Material[]       @relation("UploadedBy")
  counsellorChats  ChatMessage[]
  notifications    Notification[]
  savedCourses     SavedCourse[]

  @@index([role])
  @@index([universityId])
}

/// A course a student has saved to come back to — the wishlist. Deliberately
/// separate from Enrollment: saving is intent, enrolling is commitment, and a
/// student saves many more than they buy.
model SavedCourse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, createdAt])
}

/// A learner-facing notification — the nudge that pulls a student back:
/// "your certificate is ready", "you scored 8/10", "a new live class is set".
/// Written by lib/notifications.ts at real events; read by the dashboard bell.
model Notification {
  id String @id @default(cuid())

  /// ENROLMENT | CERTIFICATE | TEST | MATERIAL | LIVE | GENERAL — drives the icon.
  type  String
  title String
  body  String?
  /// In-app deep link the card opens when clicked, e.g. /dashboard/certificates.
  url   String?

  /// Null while unread; set the moment the student reads or dismisses it.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ------------------------------------------------------------ institutions

model University {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  shortName String
  logoUrl   String?
  coverUrl  String?
  about     String
  estYear   Int
  naacGrade String?
  approvals Json // ["UGC", "NAAC A+", "AICTE"]
  rating    Float   @default(4.5)
  reviews   Int     @default(0)
  students  Int     @default(0)
  programs  Int     @default(0)
  city      String
  state     String
  website   String?
  featured  Boolean @default(false)

  /// Directory listing: shown publicly for information + lead-gen even when NOT
  /// an ACTIVE partner. Its courses are source=DIRECTORY (display-only — applying
  /// raises a Lead, not an enrolment). AI-scraped, facts-only, "not affiliated".
  listed    Boolean @default(false)
  sourceUrl String? // where directory data was sourced from, for attribution

  // ---- partnership (the revenue relationship) ----
  /// PROSPECT -> IN_TALKS -> ACTIVE. Only ACTIVE partners' courses go live.
  partnerStatus String  @default("PROSPECT")
  /// What this university pays us per paid enrolment, as a percentage of fee.
  /// Negotiated per partner, so it lives here rather than in config.
  commissionPct Float   @default(0)
  /// Days after enrolment before commission is claimable (refund window).
  cooloffDays   Int     @default(15)
  agreementUrl  String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  courses     Course[]
  commissions Commission[]
  payouts     Payout[]
  staff       User[]       @relation("PartnerStaff")

  @@index([featured])
  @@index([partnerStatus])
  @@index([listed])
}

/// A public "Partner with us" enquiry.
///
/// Kept separate from University on purpose: the public directory and the
/// course tables must never fill with unvetted, self-declared institutions.
/// A sign-up creates a lead (and a dormant PARTNER login), and only an
/// operator's approval turns it into a real University the login is attached to.
model PartnerApplication {
  id             String  @id @default(cuid())
  universityName String
  contactName    String
  contactEmail   String
  contactPhone   String?
  website        String?
  city           String?
  state          String?
  message        String?

  /// PENDING -> APPROVED (University created, login linked) | REJECTED.
  status     String  @default("PENDING")
  reviewNote String?

  /// Soft references (like Order) — the dormant login raised at sign-up, and
  /// the University minted on approval. No FK so approval order is unconstrained.
  userId       String?
  universityId String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
}

/// A prospective student captured from a directory (non-partner) listing or a
/// "talk to a counsellor" request. Counsellors work these and try to convert
/// them onto an ACTIVE partner's programme — the revenue path. This is the lead
/// side of the aggregator model: list many for traffic, monetise the few.
model Lead {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  message String?

  /// NEW -> CONTACTED -> QUALIFIED -> CONVERTED | LOST
  status String @default("NEW")
  /// directory (applied to a non-partner listing) | callback | counsellor.
  source String @default("directory")

  /// The prospect explicitly asked to speak to a human counsellor (via the chat
  /// handoff). Floats the lead to the top of /admin/leads and drives the admin
  /// notification + email so a live counsellor can call back promptly.
  wantsAgent       Boolean   @default(false)
  agentRequestedAt DateTime?

  /// What they showed interest in, snapshotted so the lead stays readable even
  /// if the listing changes, plus the partner we're steering them toward.
  /// Soft references (like Order) — no FK.
  interestedUniversityId   String?
  interestedUniversityName String?
  interestedCourseId       String?
  interestedCourseTitle    String?
  suggestedUniversityId    String?

  /// The signed-in student who raised it, if any, and the counsellor on it.
  userId       String?
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes LeadNote[]

  @@index([status, createdAt])
  @@index([assignedToId])
}

/// Counsellor activity log on a lead — call outcomes, follow-ups.
model LeadNote {
  id         String   @id @default(cuid())
  body       String
  authorName String?
  createdAt  DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------- catalogue

model Course {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  subtitle String

  level  String // UG | PG | DIPLOMA | CERTIFICATE | INTEGRATED
  mode   String // ONLINE | DISTANCE | HYBRID | REGULAR | PART_TIME
  stream String // MANAGEMENT | ENGINEERING | MEDICAL | LAW | ARTS | SCIENCE | COMMERCE | IT

  durationYears Float
  feePerYear    Int
  originalFee   Int?
  discountPct   Int   @default(0)

  about       String
  eligibility String
  examMode    String @default("Online Proctored")

  highlights Json // string[]
  skills     Json // string[]
  recruiters Json // string[]

  thumbnailUrl  String?
  isUgcEntitled Boolean @default(true)
  hasPlacement  Boolean @default(true)
  hasLiveClass  Boolean @default(true)
  featured      Boolean @default(false)

  /// UNIVERSITY = a partner's programme; we earn commission on enrolment.
  /// PLATFORM   = our own training programme (PGDCA, AI, etc.); we keep 100%.
  /// DIRECTORY  = an AI-scraped listing from a NON-partner university. Display-
  ///             only: no enrol/pay — applying raises a Lead we convert to a partner.
  source String @default("UNIVERSITY")

  /// Publishing gate for partner-submitted programmes:
  /// DRAFT -> PENDING (submitted) -> PUBLISHED (operator-approved) | REJECTED.
  /// Defaults to PUBLISHED so operator-created and seeded courses are live at
  /// once; only partner submissions travel the review path. A course reaches
  /// students only when PUBLISHED *and* its university is an ACTIVE partner
  /// (or it is a PLATFORM course). See src/lib/visibility.ts.
  reviewStatus  String    @default("PUBLISHED")
  reviewNote    String? // operator feedback shown to the partner on rejection
  submittedAt   DateTime?
  submittedById String? // soft ref to the partner user who submitted it

  rating  Float @default(4.4)
  reviews Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  modules      Module[]
  enrollments  Enrollment[]
  materials    Material[]
  applications Application[]
  certificates Certificate[]
  courseReview Review[]
  chunks       ContentChunk[]

  // ---- PMS: academic structure behind the listing ----
  terms       Term[]
  subjects    Subject[]
  batches     Batch[]
  liveClasses LiveClass[]
  savedBy     SavedCourse[]

  gradingSchemeId String?
  gradingScheme   GradingScheme? @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([source])
  @@index([mode])
  @@index([stream])
  @@index([universityId])
  @@index([featured])
  @@index([reviewStatus])
}

/// A chapter / semester unit inside a course.
model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int     @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Optional for now: existing modules hang off the course directly, and get
  /// attached to a subject as PMS structure is filled in.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  lessons   Lesson[]
  materials Material[]
  tests     Test[]

  @@index([courseId, order])
  @@index([subjectId])
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int     @default(0)
  type        String  @default("VIDEO") // VIDEO | READING | LIVE
  durationMin Int     @default(15)
  contentUrl  String?
  body        String? // inline reading content
  /// Plain-text transcript / captions for a video lesson. Powers the transcript
  /// panel in the player (accessibility + read-along) and, later, AI summaries.
  transcript  String?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@index([moduleId, order])
}

/// Anything the admin uploads for students: notes, PDFs, question papers,
/// recorded lectures, syllabus documents.
model Material {
  id       String  @id @default(cuid())
  title    String
  type     String // PDF | NOTES | TEST_PAPER | SYLLABUS | ASSIGNMENT | RECORDING
  fileUrl  String
  fileName String
  fileSize Int     @default(0)
  mimeType String  @default("application/pdf")
  note     String?

  createdAt DateTime @default(now())

  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([moduleId])
  @@index([type])
}

// ----------------------------------------------------------- assessments

model Test {
  id          String @id @default(cuid())
  title       String
  type        String @default("QUIZ") // QUIZ | MID_TERM | FINAL
  totalMarks  Int    @default(20)
  passMarks   Int    @default(8)
  durationMin Int    @default(20)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  TestAttempt[]

  @@index([moduleId])
}

model Question {
  id           String @id @default(cuid())
  text         String
  options      Json // string[]
  correctIndex Int
  marks        Int    @default(1)
  order        Int    @default(0)

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId, order])
}

model TestAttempt {
  id          String   @id @default(cuid())
  score       Int      @default(0)
  totalMarks  Int      @default(0)
  passed      Boolean  @default(false)
  answers     Json // Record<questionId, selectedIndex>
  submittedAt DateTime @default(now())

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
}

// ------------------------------------------------------------- enrolment

model Enrollment {
  id          String    @id @default(cuid())
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED
  progressPct Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Which intake the student was admitted into — drives their calendar.
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  certificate Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

/// Multi-step admission application (the 4-step wizard).
model Application {
  id        String @id @default(cuid())
  step      Int    @default(1)
  status    String @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED
  personal  Json?
  education Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([status])
}

model Certificate {
  id       String   @id @default(cuid())
  serial   String   @unique
  grade    String   @default("A")
  issuedAt DateTime @default(now())

  /// Revoked certificates fail public verification (see verify/actions.ts).
  revoked   Boolean   @default(false)
  revokedAt DateTime?

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  body      String
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

/// Persisted AI conversation so a thread survives a reload.
///
/// One table, two threads, told apart by `courseId`:
///   null  -> the site-wide course recommender (counsellor)
///   set   -> the per-course AI tutor for an enrolled programme
/// Scoping the tutor by course is what keeps a student's questions in one
/// programme out of another's thread — and out of the recommender's.
model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String?

  @@index([userId, courseId, createdAt])
}

// ===========================================================================
// Marketplace revenue
//
// Students pay us; we owe the university their share of a PLATFORM course, or
// they owe us commission on a UNIVERSITY course. Both directions are recorded
// per enrolment so settlement is reconcilable rather than a spreadsheet.
// ===========================================================================

/// A student's payment. One order can only cover one course — partial and
/// instalment payments attach to the same order.
model Order {
  id       String @id @default(cuid())
  amount   Int // paise
  currency String @default("INR")
  status   String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  gatewayOrderId   String? @unique
  gatewayPaymentId String?
  method           String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  paidAt     DateTime?
  refundedAt DateTime?

  userId   String
  courseId String

  commission Commission?

  @@index([userId, status])
  @@index([status])
  @@index([courseId])
}

/// What a partner university owes us for one enrolment.
/// Snapshotted at creation: the rate can be renegotiated later, but a
/// historical commission must never silently change.
model Commission {
  id            String @id @default(cuid())
  courseFee     Int
  commissionPct Float
  amount        Int

  /// PENDING -> CLAIMABLE (cool-off passed) -> INVOICED -> PAID
  /// VOID when the student refunds inside the cool-off window.
  status String @default("PENDING")

  claimableAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payoutId     String?
  payout       Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([universityId, status])
  @@index([status, claimableAt])
}

/// A batched invoice to one university covering many commissions.
model Payout {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Int
  status      String   @default("DRAFT") // DRAFT | INVOICED | PAID | DISPUTED
  invoiceNo   String?  @unique
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  paidAt    DateTime?

  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  commissions  Commission[]

  @@index([universityId, status])
}

// ===========================================================================
// AI
// ===========================================================================

/// Retrieval index for the course-aware tutor.
///
/// Every lesson, material and module is chunked and embedded here. When a
/// student asks a question we retrieve only from courses they're ENROLLED in,
/// which is what lets the tutor tell "my assignment is late" in one programme
/// apart from the same words in another — and stops it inventing answers about
/// content it has never seen.
///
/// `embedding` is a JSON float array because SQLite has no vector type. On
/// Postgres this becomes a pgvector column with an ivfflat index; the
/// retrieval interface is written so only the similarity query changes.
model ContentChunk {
  id        String @id @default(cuid())
  text      String
  embedding String
  tokens    Int    @default(0)

  /// Where this text came from, for citation in the answer.
  sourceType  String // LESSON | MATERIAL | MODULE | COURSE
  sourceId    String
  sourceLabel String

  createdAt DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sourceType, sourceId])
}

/// Per-call AI metering. Written on every model call so spend is attributable
/// per feature and per student, and can be capped before it surprises anyone.
model AiUsageLog {
  id       String @id @default(cuid())
  feature  String // tutor | chatbot | resume | sop | career | interview | notes | roadmap | assessment | translate
  model    String
  provider String @default("anthropic")

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  costPaise        Int @default(0)

  latencyMs Int?
  createdAt DateTime @default(now())

  userId   String?
  courseId String?

  @@index([createdAt])
  @@index([feature])
  @@index([userId])
  @@index([courseId])
}

// ===========================================================================
// PMS — Programme Management
//
// The academic definition of a programme, as the institution registers it:
// semesters, subjects, credits, grading, intakes.
//
// Deliberately additive. `Course` remains the marketplace listing students
// browse and buy; these models describe the academic structure behind it.
// Existing Modules keep hanging off Course, and can additionally be attached
// to a Subject as structure is filled in — so the LMS never breaks mid-migration.
// ===========================================================================

/// A semester / year within a programme.
model Term {
  id              String @id @default(cuid())
  number          Int // 1..n, ordered
  title           String // "Semester 1"
  creditsRequired Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  subjects Subject[]

  @@unique([courseId, number])
  @@index([courseId])
}

/// A paper/subject carrying credits and a marks split.
/// This is the unit a university actually examines and grades.
model Subject {
  id      String @id @default(cuid())
  code    String // "BBA-DM-201"
  title   String
  credits Int    @default(4)

  kind String @default("CORE") // CORE | ELECTIVE | LAB | PROJECT | AUDIT

  /// Indian universities near-universally split assessment this way, so it's
  /// modelled explicitly rather than buried in a total.
  internalMarks Int @default(30)
  externalMarks Int @default(70)

  syllabusOutline String?

  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId   String?
  term     Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)

  modules     Module[]
  liveClasses LiveClass[]

  @@unique([courseId, code])
  @@index([courseId])
  @@index([termId])
}

/// An intake cohort — "BBA DM, Aug 2026 intake".
/// Students are admitted into a batch, which is what drives the calendar.
model Batch {
  id          String    @id @default(cuid())
  name        String // "2026-29"
  intakeMonth String // "AUGUST"
  startDate   DateTime
  endDate     DateTime?
  seats       Int       @default(0)
  status      String    @default("OPEN") // OPEN | CLOSED | RUNNING | COMPLETED

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  events      AcademicEvent[]

  @@index([courseId, status])
}

/// Term starts, exam windows, result dates — per batch.
model AcademicEvent {
  id       String    @id @default(cuid())
  type     String // TERM_START | TERM_END | EXAM | RESULT | HOLIDAY | FEE_DUE
  title    String
  startsAt DateTime
  endsAt   DateTime?
  notes    String?

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, startsAt])
}

/// Marks -> grade -> grade points. Varies by university, so it's data.
model GradingScheme {
  id        String @id @default(cuid())
  name      String
  /// [{ "min": 90, "grade": "A+", "points": 10 }, ...] evaluated high to low.
  bands     Json
  maxPoints Float  @default(10)

  courses Course[]
}

/// A student's result for one subject. Feeds SGPA/CGPA.
model SubjectResult {
  id            String  @id @default(cuid())
  internalScore Int     @default(0)
  externalScore Int     @default(0)
  totalScore    Int     @default(0)
  grade         String?
  gradePoints   Float?
  status        String  @default("PENDING") // PENDING | PASS | FAIL | WITHHELD

  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  userId    String
  subjectId String

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

// ===========================================================================
// Live classes
// ===========================================================================

/// A scheduled online class.
///
/// `roomName` carries a random suffix and is NEVER sent to the browser
/// directly — a guessable room is an open door into a paying student's class.
/// The join URL is minted by /api/live/[id]/join after an enrolment check.
model LiveClass {
  id          String  @id @default(cuid())
  title       String
  description String?

  provider    String  @default("JITSI") // JITSI | ZOOM | MEET
  roomName    String  @unique
  /// Only set for externally-hosted classes (a tutor's own Zoom link).
  externalUrl String?

  startsAt    DateTime
  durationMin Int      @default(60)
  status      String   @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED

  /// Published after the class; gated by the same enrolment check.
  recordingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  hostId    String?

  attendance LiveAttendance[]

  @@index([courseId, startsAt])
  @@index([status, startsAt])
}

/// One row per student per class — the attendance register.
model LiveAttendance {
  id         String   @id @default(cuid())
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Minutes present, updated by heartbeats. Drives the attendance percentage
  /// universities actually care about — "clicked join" is not attendance.
  minutes    Int      @default(0)

  userId      String
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([userId, liveClassId])
  @@index([liveClassId])
}

// ------------------------------------------------------------------- shop

/// A sellable item in the student shop — a competitive-exam book or a piece of
/// stationery.
///
/// One table covers both because 90% of the fields are shared (price, stock,
/// images, SEO copy) and only the bibliographic block differs. `kind` says which
/// shape a row is, and the book-only columns are nullable and simply left unset
/// for stationery. Splitting these into two tables would double every query,
/// every admin screen and the cart join for very little gain.
///
/// Money is stored in PAISE everywhere in this section, matching Order.amount,
/// so cart arithmetic never round-trips through floating point rupees.
model Product {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  /// One-line shelf description shown under the title and in meta tags.
  subtitle String

  /// BOOK | STATIONERY
  kind String

  /// Broad shelf, e.g. ENGINEERING_ENTRANCE, MEDICAL_ENTRANCE, NOTEBOOKS,
  /// WRITING, GEOMETRY. See SHOP_CATEGORIES in src/lib/shop.ts.
  category String

  /// Long-form description, rendered as paragraphs on the product page.
  description String
  /// string[] — the bulleted selling points beside the price.
  highlights  Json

  /// Selling price in paise.
  price Int
  /// Printed MRP in paise, when it differs — drives the strike-through and the
  /// discount badge. Never below `price`; the admin form enforces that.
  mrp   Int?

  /// Units on hand. 0 renders as "Out of stock" and blocks add-to-cart.
  stock Int     @default(0)
  sku   String? @unique

  imageUrl String?
  /// string[] — additional gallery images.
  images   Json

  /// DRAFT | PUBLISHED | ARCHIVED. Only PUBLISHED reaches the storefront;
  /// see shopVisibility in src/lib/visibility.ts.
  status   String  @default("DRAFT")
  featured Boolean @default(false)

  // ---- book-only; null for stationery ----
  author        String?
  publisher     String?
  isbn          String?
  edition       String?
  language      String?
  pages         Int?
  binding       String? // Paperback | Hardcover | Spiral
  publishedYear Int?
  /// string[] — exams this title targets, e.g. ["JEE Main", "NEET"]. Powers the
  /// exam filter and the "recommended for" strip.
  examTags      Json

  // ---- stationery-only; null for books ----
  brand String?
  /// string[] of "Label: value" rows for the spec table (size, ruling, GSM…).
  specs Json

  rating  Float @default(0)
  reviews Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems ShopOrderItem[]

  @@index([status, kind])
  @@index([status, category])
  @@index([featured])
  @@index([kind])
}

/// A shop purchase. Deliberately separate from `Order`, which is welded to a
/// single courseId and carries the university commission relation — a basket of
/// physical goods shares none of that lifecycle.
model ShopOrder {
  /// Human-quotable reference shown to the student and used in support email.
  orderNumber String @unique
  id          String @id @default(cuid())

  /// PENDING -> PAID -> PACKED -> SHIPPED -> DELIVERED
  /// CANCELLED (before dispatch) | REFUNDED (after payment).
  status String @default("PENDING")

  /// All paise. `total` = subtotal + shipping, stored rather than recomputed so
  /// a later change to the shipping rule can't rewrite historical orders.
  subtotal Int
  shipping Int
  total    Int

  gatewayOrderId   String? @unique
  gatewayPaymentId String?

  /// Null for a guest checkout; set when the buyer was signed in.
  userId String?

  // ---- delivery address, snapshotted at checkout ----
  name    String
  email   String
  phone   String
  line1   String
  line2   String?
  city    String
  state   String
  pincode String

  courier        String?
  trackingNumber String?
  /// Operator-only note — never shown to the buyer.
  adminNote      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  refundedAt  DateTime?
  cancelledAt DateTime?

  items ShopOrderItem[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([email])
}

/// One line of a shop order.
///
/// Title and price are SNAPSHOTS. A product renamed or repriced next month must
/// not retroactively change what an invoice says was bought, and the product may
/// be archived entirely — hence onDelete: SetNull rather than Cascade.
model ShopOrderItem {
  id    String @id @default(cuid())
  title String
  /// Unit price in paise at the moment of purchase.
  price Int
  qty   Int

  orderId String
  order   ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}
