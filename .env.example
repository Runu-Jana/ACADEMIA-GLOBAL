# ---------------------------------------------------------------- core
# Postgres. For local dev, `docker compose up -d` starts one on 127.0.0.1:5544;
# then `npx prisma migrate dev` and `npx prisma db seed`. In production use a
# managed Postgres (Neon, Supabase, RDS, …) and paste its connection string.
DATABASE_URL="postgresql://shiksha:shiksha@127.0.0.1:5544/shiksha_sarthi?schema=public"
# Isolated database for the Vitest suite (defaults to shiksha_sarthi_test on the
# same local Postgres). Create it once:
#   docker exec shiksha-sarthi-db psql -U shiksha -d shiksha_sarthi -c "CREATE DATABASE shiksha_sarthi_test;"
TEST_DATABASE_URL="postgresql://shiksha:shiksha@127.0.0.1:5544/shiksha_sarthi_test?schema=public"
# Sign/verify session cookies. Generate a long random string for production.
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Shiksha Sarthi"
# Public base URL. Everything that needs an absolute link reads this: the
# sitemap, robots.txt and JSON-LD, every transactional email, the live-class
# redirects, and the verify link encoded in each certificate's QR code.
# Without it those all fall back to http://localhost:3000 — set it in
# production before you point a crawler or send a single email.
# (NEXT_PUBLIC_APP_URL is still honoured as a legacy alias; prefer this one.)
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# ============================================================================
# AI — the course tutor and the admin ingest tools
# ============================================================================
#
# GENERATION (tutor answers, prospectus extraction) runs on Anthropic by
# default. This one key is all you need for a working, grounded AI tutor —
# without an embeddings key it retrieves lexically.
ANTHROPIC_API_KEY=""

# EMBEDDINGS (optional) upgrade retrieval from lexical to semantic. Anthropic
# sells no embeddings model, so this borrows OpenAI's cheapest embedder. Also
# used if you route any generation feature to a gpt-* model. After adding it,
# rebuild the index: `npm run ai:index`.
OPENAI_API_KEY=""

# ---- tuning (all optional; sensible defaults in src/lib/ai/types.ts) ----
# 'balanced' (default) or 'economy' — the per-feature model routing profile.
# AI_COST_PROFILE="balanced"
# Override the model for one feature, e.g. put the tutor on a stronger model:
# AI_MODEL_TUTOR="claude-opus-4-8"
# Cap output tokens for one feature (a direct cost lever):
# AI_MAXTOKENS_TUTOR="900"
# Embeddings model (default text-embedding-3-small):
# AI_EMBED_MODEL="text-embedding-3-small"
# Per-user AI calls allowed per hour (default 60):
# AI_HOURLY_LIMIT="60"
# USD→INR rate used to bill AI spend in paise (default 88):
# USD_TO_INR="88"

# ============================================================================
# Payments — Razorpay (course enrolment fees)
# ============================================================================
#
# Test keys from dashboard.razorpay.com → Settings → API Keys. Without these,
# a dev build falls back to a demo enrol so the apply flow stays testable;
# production refuses to enrol without collecting payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook secret (Settings → Webhooks). The webhook is the reliable
# confirmation path for production; the checkout signature covers local dev
# where Razorpay can't reach a localhost URL. Point the webhook at
# https://<your-domain>/api/payments/webhook for events: payment.captured,
# order.paid, refund.processed.
RAZORPAY_WEBHOOK_SECRET=""

# ============================================================================
# Email — admin notifications (e.g. a live-counsellor request from the chat)
# ============================================================================
#
# Optional. When a prospect asks Sarthi to connect them with a live counsellor,
# the lead is always flagged in the admin panel (the durable signal). If these
# are set, an email nudge is also sent via Resend's HTTP API — no SDK needed.
# Without them the email step is skipped cleanly (logged, never throws).
#
# Get a key at resend.com → API Keys. ADMIN_EMAIL is where alerts land.
RESEND_API_KEY=""
ADMIN_EMAIL=""
# Sender address. Resend's shared 'onboarding@resend.dev' works before you verify
# a domain; use a from-address on your own verified domain in production.
# EMAIL_FROM="Shiksha Sarthi <no-reply@your-domain.example>"

# ============================================================================
# Scheduled maintenance (cron)
# ============================================================================
#
# Commissions past their cool-off window are promoted to CLAIMABLE by a daily
# job (/api/cron). Set a long random secret, then point an external scheduler
# (Vercel Cron, cron-job.org, a server crontab…) at:
#   GET https://<your-domain>/api/cron   with header  Authorization: Bearer <CRON_SECRET>
# Without this set, /api/cron refuses to run (503).
CRON_SECRET=""

# ============================================================================
# Live classes — Jitsi
# ============================================================================
#
# Base URL of the Jitsi deployment that hosts live classes. Defaults to the
# PUBLIC instance at https://meet.jit.si, where rooms are unbranded and anyone
# who guesses a room name can walk in. Point this at your own self-hosted or
# paid (JaaS) instance before running a real class.
# JITSI_BASE_URL="https://meet.jit.si"

# ============================================================================
# Error monitoring
# ============================================================================
#
# lib/observability.ts funnels unexpected errors through one chokepoint and, by
# default, writes a single structured JSON line to stderr — which a log drain
# (Vercel, Datadog, CloudWatch) can parse and alert on. NOTHING ALERTS ON ITS
# OWN until you either configure that drain or attach a vendor SDK at the marked
# spot in captureError(). SENTRY_DSN is read by nothing today; it is here as the
# intended wiring point.
# SENTRY_DSN=""
