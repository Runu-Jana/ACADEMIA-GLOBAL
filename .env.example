# ---------------------------------------------------------------- core
DATABASE_URL="file:./dev.db"
# Sign/verify session cookies. Generate a long random string for production.
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Academia Global"

# ============================================================================
# AI — the course tutor and the admin ingest tools
# ============================================================================
#
# GENERATION (tutor answers, prospectus extraction) runs on Anthropic by
# default. This one key is all you need for a working, grounded AI tutor —
# without an embeddings key it retrieves lexically.
ANTHROPIC_API_KEY=""

# EMBEDDINGS (optional) upgrade retrieval from lexical to semantic. Anthropic
# sells no embeddings model, so this borrows OpenAI's cheapest embedder. Also
# used if you route any generation feature to a gpt-* model. After adding it,
# rebuild the index: `npm run ai:index`.
OPENAI_API_KEY=""

# ---- tuning (all optional; sensible defaults in src/lib/ai/types.ts) ----
# 'balanced' (default) or 'economy' — the per-feature model routing profile.
# AI_COST_PROFILE="balanced"
# Override the model for one feature, e.g. put the tutor on a stronger model:
# AI_MODEL_TUTOR="claude-opus-4-8"
# Cap output tokens for one feature (a direct cost lever):
# AI_MAXTOKENS_TUTOR="900"
# Embeddings model (default text-embedding-3-small):
# AI_EMBED_MODEL="text-embedding-3-small"
# Per-user AI calls allowed per hour (default 60):
# AI_HOURLY_LIMIT="60"
# USD→INR rate used to bill AI spend in paise (default 88):
# USD_TO_INR="88"

# ============================================================================
# Payments — Razorpay (course enrolment fees)
# ============================================================================
#
# Test keys from dashboard.razorpay.com → Settings → API Keys. Without these,
# a dev build falls back to a demo enrol so the apply flow stays testable;
# production refuses to enrol without collecting payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook secret (Settings → Webhooks). The webhook is the reliable
# confirmation path for production; the checkout signature covers local dev
# where Razorpay can't reach a localhost URL. Point the webhook at
# https://<your-domain>/api/payments/webhook for events: payment.captured,
# order.paid, refund.processed.
RAZORPAY_WEBHOOK_SECRET=""
